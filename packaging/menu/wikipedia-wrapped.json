{
  "$schema": "https://schemas.conda.org/menuinst-1-1-3.schema.json",
  "menu_name": "Wikipedia Wrapped",
  "menu_items": [
    {
      "name": "Wikipedia Wrapped",
      "description": "Your Wikipedia reading history, mapped and summarized.",
      "icon": "{{ MENU_DIR }}/wikipedia-wrapped.{{ ICON_EXT }}",
      "activate": false,
      "terminal": false,
      "command": ["{{ PYTHON }}", "{{ PREFIX }}/share/wikipedia-wrapped/launch.py"],
      "platforms": {
        "osx": {
          "command": [
            "{{ MENU_ITEM_LOCATION }}/Contents/MacOS/python",
            "{{ PREFIX }}/share/wikipedia-wrapped/launch.py"
          ],
          "link_in_bundle": {
            "{{ PREFIX }}/bin/python": "{{ MENU_ITEM_LOCATION }}/Contents/MacOS/python"
          },
          "CFBundleName": "WikipediaWrapped",
          "CFBundleDisplayName": "Wikipedia Wrapped",
          "CFBundleIdentifier": "io.github.emers245.wikipediawrapped",
          "CFBundleVersion": "@VERSION@"
        },
        "win": {
          "command": [
            "{{ PYTHONW }}",
            "{{ PREFIX }}/share/wikipedia-wrapped/launch.py"
          ],
          "desktop": true,
          "app_user_model_id": "emers245.WikipediaWrapped"
        }
      }
    }
  ]
}
