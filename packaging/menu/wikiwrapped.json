{
  "$schema": "https://schemas.conda.org/menuinst-1-1-3.schema.json",
  "menu_name": "WikiWrapped",
  "menu_items": [
    {
      "name": "WikiWrapped",
      "description": "Your Wikipedia reading history, mapped and summarized.",
      "icon": "{{ MENU_DIR }}/wikiwrapped.{{ ICON_EXT }}",
      "activate": false,
      "terminal": false,
      "command": ["{{ PYTHON }}", "{{ PREFIX }}/share/wikiwrapped/launch.py"],
      "platforms": {
        "osx": {
          "command": [
            "{{ MENU_ITEM_LOCATION }}/Contents/MacOS/python",
            "{{ PREFIX }}/share/wikiwrapped/launch.py"
          ],
          "link_in_bundle": {
            "{{ PREFIX }}/bin/python": "{{ MENU_ITEM_LOCATION }}/Contents/MacOS/python"
          },
          "CFBundleName": "WikiWrapped",
          "CFBundleDisplayName": "WikiWrapped",
          "CFBundleIdentifier": "io.github.emers245.wikiwrapped",
          "CFBundleVersion": "@VERSION@"
        },
        "win": {
          "command": [
            "{{ PYTHONW }}",
            "{{ PREFIX }}/share/wikiwrapped/launch.py"
          ],
          "desktop": true,
          "app_user_model_id": "emers245.WikiWrapped"
        }
      }
    }
  ]
}
