# Google Desktop Client Key
client_secret*.json

# OAuth tokens, one per authorized account. These grant read-only Drive
# access to a real Google account: never commit them.
tokens/
*.token.json

# Local preferences (may name Google accounts). The app now keeps these in
# the per-user data dir; these rules still cover the pre-migration copies
# in a checkout (see app/migrate.py).
config.local.toml

# Local data: database + reference-space artifacts (kept out of git; see repo_spec S4).
# User data now lives in the per-user data dir; data/ in a checkout holds the
# read-only reference space and any not-yet-migrated legacy files.
data/*
!data/reference/
data/reference/*
!data/reference/.gitkeep

# Personal contact email, from when the Wikimedia User-Agent required one.
# No longer read (the UA names the project URL); kept ignored so a leftover
# copy can never be committed.
contact_email.txt

# Browsing history stays local and is never pushed (decision 2026-08-09).
# The append-only log and the DB are already covered by the data/ rules
# above; these cover extractor output and any archive left in the tree.
# The files already tracked under reference_code/ predate this rule and are
# deliberately left as they are.
wikipedia_history.json
*history*.json
*History*.json
takeout*.zip
Takeout*.zip
*.jsonl

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# macOS
.DS_Store

# Packaging outputs (Milestones 2-3): fetched/packaged reference spaces,
# staged resources, built conda packages and installers. Large binaries,
# rebuilt from the scripts in packaging/ and scripts/; never committed.
packaging/build/
*.tar.gz
*.pkg
*.exe

# The bundled resources folder an installer puts next to the code
# (config.INSTALLED_RESOURCES_NAME). Its presence switches the app into
# installed mode, so it must never appear in a checkout by accident.
/resources/
